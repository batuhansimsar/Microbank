# Environment Variables Template for Microbank

# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# JWT Secret Key (minimum 32 characters)
# Generate a secure random key for production
JWT_SECRET_KEY=YourProductionSecretKeyHere-MustBeAtLeast32CharactersLong!

# Database Connection Strings
IDENTITY_DB_CONNECTION=Host=identity-db;Port=5432;Database=microbank_identity;Username=postgres;Password=YOUR_DB_PASSWORD
ACCOUNT_DB_CONNECTION=Host=account-db;Port=5432;Database=microbank_account;Username=postgres;Password=YOUR_DB_PASSWORD
TRANSFER_DB_CONNECTION=Host=transfer-db;Port=5432;Database=microbank_transfer;Username=postgres;Password=YOUR_DB_PASSWORD

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
